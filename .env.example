# ---- Server-only secrets. NEVER prefix any of these with NEXT_PUBLIC_ ----

# Google Gemini API key (free tier) — used only inside /api routes, never
# shipped to the client. Get one free (no card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Shared team passcode reps type once on the gate screen.
TEAM_PASSCODE=change-me

# Shared secret that must match the Apps Script script property of the same name.
LOG_SHARED_SECRET=change-me-too

# Apps Script Web App /exec URL for Google Sheets logging.
# Leave unset to disable logging — the app still works fully without it.
LOG_WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
